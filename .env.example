# ─── Mikian.Photos — environment template ────────────────────────────────────
#
# Copy to `.env.local` (gitignored) and fill in. Two ways to get one:
#
#   1. Pull the real values from Vercel — if they're readable there. A variable
#      marked Sensitive in Vercel is write-only: `vercel env pull` writes the
#      literal string "[SENSITIVE]" instead of the value, and the app then fails
#      at request time (Prisma: "the URL must start with the protocol
#      postgresql://"). dev-env-local.mjs names any that came down that way; the
#      cure is the issuing service's own dashboard, not Vercel.
#        npx vercel login && npx vercel link && npx vercel env pull .env.local
#        node scripts/dev-env-local.mjs      # ← then this, before npm run dev
#      The second command points auth and links back at localhost and closes
#      the buy flow, which a pulled production env leaves open. It appends an
#      override block; nothing pulled is rewritten.
#
#   2. Local-only sandbox, no secrets, no cloud (works for /row100k and most UI):
#        node scripts/dev-local.mjs
#      It writes a .env.local pointing at a local Postgres and seeds the demo
#      board. Photos/R2, face rec, email and PayPal stay inert.
#
# Only POSTGRES_URL is needed to boot. Everything else degrades: a page that
# needs a missing key fails on that page, not at startup.

# ─── Database (required) ─────────────────────────────────────────────────────
# Vercel Postgres → Storage tab → ".env.local" → Copy snippet. Prisma reads
# POSTGRES_URL at runtime and POSTGRES_URL_NON_POOLING for migrations.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/mikian?schema=public
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@localhost:5432/mikian?schema=public
# Cosmetic only — scripts/row100k-demo-seed.ts prints this host as a safety check.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mikian?schema=public

# ─── Auth (needed to sign in, and to mint download tokens) ───────────────────
# Google Cloud console → Credentials → OAuth client. `http://localhost:3000`
# and `http://localhost:3000/api/auth/callback/google` are already whitelisted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32   (any non-empty string works locally)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Photo storage — Cloudflare R2 (photo pages need this) ───────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mikian-photos
R2_PUBLIC_URL=

# ─── Face recognition — AWS Rekognition (upload pipeline only) ───────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_COLLECTION_PREFIX=mikian-photos
# Face-assignment tuning; defaults are 250 and 0.06 when unset.
SUPERCLUSTER_MAX_PHOTOS=
SUPERCLUSTER_MAX_FRACTION=

# ─── Payments — PayPal ───────────────────────────────────────────────────────
# PAYPAL_ENV is "sandbox" unless it is exactly "live". Keep it sandbox locally.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# WARNING: payments are OPEN by default. Only the exact string "true" locks the
# buy flow — `PAYMENTS_LOCKED=1` does NOT lock it. If you pulled production
# PayPal credentials, set this to true so a local click can't take a real order.
PAYMENTS_LOCKED=true
# Lets the owner past the lock via /api/unlock?key=...
MIKIAN_UNLOCK_KEY=

# ─── Email — Resend (order receipts) ─────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
OWNER_EMAIL=

# ─── Optional ────────────────────────────────────────────────────────────────
# Rate limiting; without it limits fall back to in-memory per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# "Save to Dropbox" button on the order page.
NEXT_PUBLIC_DROPBOX_APP_KEY=
# Guards /api/cron/backfill-detection (Vercel cron sends it).
CRON_SECRET=

# ─── Two databases (dev vs prod) ─────────────────────────────────────────────
# Keep the DEV database in this file. To also work against PRODUCTION, create
# `.env.proddb.local` (gitignored) holding ONLY the prod connection strings:
#
#     POSTGRES_URL=postgres://...
#     POSTGRES_URL_NON_POOLING=postgres://...
#     DATABASE_URL=postgres://...
#
# The swap is stateless — which database you get is decided by which script
# you run, nothing is toggled:
#
#     npm run dev            → dev database, /row100k demo board + shifted clock
#     npm run dev:live       → dev database, real clock, live namespace
#     npm run dev:proddb     → PRODUCTION database, real clock (writes are real)
#     npm run db:status      → prints which database each script points at
#
# dev:proddb layers .env.proddb.local over this file (first file wins in
# dotenv-cli), so auth, PAYMENTS_LOCKED=true and the rest still come from
# here; it refuses to start if .env.proddb.local is missing, because dotenv
# silently skips a missing file and you'd be on the dev database believing
# you're on prod.

# NOT set here: NEXT_PUBLIC_ROW100K_DEMO and NEXT_PUBLIC_ROW100K_NOW — the
# `npm run dev` script passes those on the command line.
#
# And do NOT keep a VERCEL_ENV=production that came out of `vercel env pull`.
# src/lib/row100k.ts:65 zeroes the demo clock when it sees that on the server,
# but VERCEL_ENV isn't NEXT_PUBLIC_ so the browser bundle never sees it — the
# countdown ticks on demo time while the server uses the real date, which is
# the server/client split the comment at row100k.ts:61 warns about.

{
  "name": "mikian-photos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -v NEXT_PUBLIC_ROW100K_DEMO=1 -v NEXT_PUBLIC_ROW100K_NOW=2026-09-20T19:00:00Z -- next dev",
    "dev:live": "next dev",
    "dev:proddb": "node scripts/db-status.mjs --require .env.proddb.local && dotenv -e .env.proddb.local -e .env.local -- next dev",
    "db:status": "node scripts/db-status.mjs",
    "dev:row100k": "npm run dev",
    "dev:row100k:lan": "dotenv -e .env.local -v NEXT_PUBLIC_ROW100K_DEMO=1 -v NEXT_PUBLIC_ROW100K_NOW=2026-09-20T19:00:00Z -- next dev -H 0.0.0.0",
    "prebuild": "node scripts/gallery-manifest.mjs",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:seed": "dotenv -e .env.local -- prisma db seed",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:studio:proddb": "node scripts/db-status.mjs --require .env.proddb.local && dotenv -e .env.proddb.local -e .env.local -- prisma studio",
    "row100k:thumbs": "dotenv -e .env.local -- tsx scripts/row100k-thumbs.ts",
    "row100k:demo": "dotenv -e .env.local -- tsx scripts/row100k-demo-seed.ts",
    "row100k:demo:clear": "dotenv -e .env.local -- tsx scripts/row100k-demo-seed.ts --clear",
    "db:backup": "dotenv -e .env.local -- tsx scripts/db-backup.ts",
    "db:restore": "dotenv -e .env.local -- tsx scripts/db-restore.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1055.0",
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "@paypal/react-paypal-js": "^9.2.0",
    "@prisma/client": "^5.22.0",
    "@types/archiver": "^7.0.0",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "archiver": "^7.0.1",
    "exifr": "^7.1.3",
    "jose": "^5.10.0",
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}

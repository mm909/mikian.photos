{
  "expo": {
    "name": "ROW",
    "slug": "rowtember",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rowtember.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "ROW connects to your Concept2 monitor over Bluetooth to read your row.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rowtember.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "ROW connects to your Concept2 monitor over Bluetooth to read your row."
        }
      ],
      "expo-dev-client",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ROW attaches two photos to each row you log: you, and the monitor.",
          "cameraPermission": "ROW takes the two photos that go with each row you log: you, and the monitor.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "scheme": "rowtember",
    "backgroundColor": "#F4F3EE",
    "experiments": {
      "baseUrl": "/row100k/app"
    },
    "extra": {
      "eas": {
        "projectId": "85598694-322d-4c29-b2ca-2233f86b1058"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85598694-322d-4c29-b2ca-2233f86b1058"
    }
  }
}

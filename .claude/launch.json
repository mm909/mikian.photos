{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mikian-photos-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mikian-photos-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:live"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "row100k-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:row100k"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "row100k-dec",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:row100k:dec"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "row100k-oct",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:row100k:oct"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "rowtember-app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
